{
  "name": "tbr-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tbr generate --router src/router.ts",
    "watch": "tbr generate --watch --router src/router.ts",
    "ir": "tbr generate --dry-run --router src/router.ts",
    "check": "tbr check --router src/router.ts",
    "typecheck": "tbr generate --router src/router.ts && tsc -p tsconfig.json",
    "serve": "node --watch --experimental-strip-types --no-warnings src/server.ts",
    "client": "node --experimental-strip-types --no-warnings src/client.ts"
  },
  "dependencies": {
    "ts-bin-rpc": "workspace:*"
  },
  "devDependencies": {
    "@tbr/cli": "workspace:*",
    "typescript": "7.1.0-beta",
    "@types/node": "22"
  }
}
