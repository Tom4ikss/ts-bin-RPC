{
  "name": "tbr-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tbr generate --router src/router.ts",
    "watch": "node --watch-path=src/router.ts --experimental-strip-types --no-warnings ../packages/cli/src/cli.ts generate --router src/router.ts",
    "ir": "tbr generate --dry-run --router src/router.ts",
    "check": "tbr check --router src/router.ts",
    "typecheck": "tbr generate --router src/router.ts && tsc -p tsconfig.json",
    "demo": "node --experimental-strip-types --no-warnings src/demo.ts"
  },
  "dependencies": {
    "ts-bin-rpc": "workspace:*"
  },
  "devDependencies": {
    "ts-bin-rpc-cli": "workspace:*",
    "typescript": "7.1.0-beta"
  }
}
