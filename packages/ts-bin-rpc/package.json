{
  "name": "ts-bin-rpc",
  "version": "0.1.0-alpha.0",
  "description": "Code-first binary RPC for TypeScript: lazy views over the response bytes, numeric arrays as TypedArray columns.",
  "keywords": [
    "rpc",
    "typescript",
    "binary",
    "serialization",
    "zero-copy",
    "typed-array",
    "codegen"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Artem Shaov",
  "homepage": "https://tom4ikss.github.io/ts-bin-RPC/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tom4ikss/ts-bin-RPC.git",
    "directory": "packages/ts-bin-rpc"
  },
  "bugs": "https://github.com/Tom4ikss/ts-bin-RPC/issues",
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.1.0-beta",
    "@types/node": "22"
  }
}
