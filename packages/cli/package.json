{
  "name": "ts-bin-rpc-cli",
  "version": "0.1.0-alpha.0",
  "description": "Code generator for ts-bin-rpc: reads TypeScript types, maintains the schema lockfile, emits codecs.",
  "keywords": [
    "rpc",
    "typescript",
    "codegen",
    "ts-bin-rpc"
  ],
  "type": "module",
  "bin": {
    "tbr": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Artem Shaov",
  "homepage": "https://tom4ikss.github.io/ts-bin-RPC/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tom4ikss/ts-bin-RPC.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Tom4ikss/ts-bin-RPC/issues",
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "bin": {
      "tbr": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs",
    "tbr": "node --experimental-strip-types --no-warnings src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "typescript": "7.1.0-beta",
    "ts-bin-rpc": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
