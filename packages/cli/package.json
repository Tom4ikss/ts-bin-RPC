{
  "name": "@tbr/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Sources and tests of the tbr command. Published inside ts-bin-rpc as dist/cli, not on its own.",
  "type": "module",
  "bin": {
    "tbr": "./src/cli.ts"
  },
  "scripts": {
    "tbr": "node --experimental-strip-types --no-warnings src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ts-bin-rpc": "workspace:*",
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "vite": "^8.3.5"
  },
  "license": "MIT"
}
