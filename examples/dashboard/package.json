{
  "name": "tbr-example-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tbr generate --router src/server/router.ts",
    "dev": "tbr generate --router src/server/router.ts && vite",
    "build": "tbr generate --router src/server/router.ts && vite build",
    "start": "node --experimental-strip-types --no-warnings src/server/main.ts",
    "typecheck": "tbr generate --router src/server/router.ts && tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-bin-rpc": "workspace:*",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@tbr/cli": "workspace:*",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.5"
  }
}
