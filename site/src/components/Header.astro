---
// Header: logo and primary links on the left, search, GitHub and the theme toggle on the right.
// The same header is used on the landing page and in the docs.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from './ThemeSelect.astro';
import { GITHUB, href, unbase } from '../lib/guide.mjs';

const path = unbase(Astro.url.pathname);
const links = [
	{ label: 'Docs', href: href('/guide/'), current: path.startsWith('/guide') && !path.startsWith('/guide/performance') },
	{ label: 'Benchmarks', href: href('/guide/performance/'), current: path.startsWith('/guide/performance') },
	{ label: 'Example', href: `${GITHUB}/tree/main/examples/dashboard`, current: false },
];
---

<div class="tbr-header">
	<div class="left">
		<SiteTitle />
		<span class="status" title="Published as an alpha; the wire format may change before 1.0">alpha</span>
		<nav class="primary sl-hidden md:sl-flex" aria-label="Primary">
			{links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
		</nav>
	</div>
	<div class="right">
		<div class="search print:hidden"><Search /></div>
		<div class="sl-hidden md:sl-flex icons print:hidden">
			<a class="icon-link" href={GITHUB} aria-label="ts-bin-rpc on GitHub" title="GitHub">
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"></path></svg>
			</a>
			<ThemeSelect />
		</div>
	</div>
</div>

<style>
	.tbr-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
		max-width: 90rem;
		margin-inline: auto;
	}
	.left,
	.right {
		display: flex;
		align-items: center;
		min-width: 0;
	}
	.left {
		gap: 0.75rem;
	}
	.right {
		gap: 0.625rem;
	}
	.status {
		font-family: var(--__sl-font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		border: 1px solid var(--tbr-border);
		border-radius: 999px;
		padding: 0.1rem 0.45rem;
		white-space: nowrap;
	}
	.primary {
		gap: 0.125rem;
		margin-inline-start: 0.75rem;
		padding-inline-start: 1rem;
		border-inline-start: 1px solid var(--tbr-border);
	}
	.primary a {
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		padding: 0.35rem 0.625rem;
		border-radius: 0.4rem;
		transition: color 0.15s, background-color 0.15s;
	}
	.primary a:hover {
		color: var(--sl-color-white);
	}
	.primary a[aria-current='page'] {
		color: var(--sl-color-white);
	}
	.icons {
		align-items: center;
		gap: 0.25rem;
	}
	.icon-link {
		display: inline-grid;
		place-items: center;
		width: 2.125rem;
		height: 2.125rem;
		border-radius: 0.5rem;
		color: var(--sl-color-gray-3);
		border: 1px solid transparent;
		transition: color 0.15s, background-color 0.15s, border-color 0.15s;
	}
	.icon-link:hover {
		color: var(--sl-color-white);
		background: var(--tbr-surface);
		border-color: var(--tbr-border);
	}
	@media (max-width: 49.99rem) {
		.status {
			display: none;
		}
		/* Leave room for Starlight's menu button, which sits on top of the header on pages with a sidebar. */
		:global(:root[data-has-sidebar]) .right {
			margin-inline-end: 2.75rem;
		}
		/* Pages without a sidebar (landing, 404) have no menu: keep GitHub and the theme toggle visible. */
		:global(:root:not([data-has-sidebar])) .icons {
			display: flex;
		}
	}
</style>
