---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Flow from '../components/landing/Flow.astro';
import Bench from '../components/landing/Bench.astro';
import Libs from '../components/landing/Libs.astro';
import { GITHUB, href } from '../lib/guide.mjs';
import { BUNDLE } from '../data/bench';
import '../styles/landing.css';

const features = [
	{
		glyph: 'T',
		title: 'Your types are the schema',
		text: 'Interfaces, unions, Date, generics, recursive types and typed arrays. No IDL to keep in sync and no validator DSL.',
		href: href('/guide/types/'),
	},
	{
		glyph: 'u8',
		title: 'Branded numbers pick widths',
		text: 'u8, u16, u32, i32, f32, i64 and friends are number or bigint with an invisible tag. Assignments need no casts; the encoder checks ranges.',
		href: href('/guide/types/#numeric-brands'),
	},
	{
		glyph: '{…}',
		title: 'Lazy, zero-copy views',
		text: 'A response is verified once, then read on demand. Strings decode on first read and a field you never touch costs nothing.',
		href: href('/guide/views/'),
	},
	{
		glyph: 'f32[]',
		title: 'Columns straight into charts',
		text: 'Float32Array and Float64Array fields come back as views over the response bytes. Hand them to uPlot or WebGL as they are.',
		href: href('/guide/views/'),
	},
	{
		glyph: 'lock',
		title: 'Schema evolution in CI',
		text: 'tbr.lock.json gives every field a stable ID. tbr check labels each change safe or breaking, and stale generated code fails tsc.',
		href: href('/guide/evolution/'),
	},
	{
		glyph: 'fetch',
		title: 'Small, and runs anywhere',
		text: `A Fetch API handler for Node, Bun, Deno and Workers. A ${BUNDLE.runtime} client runtime, no eval, so strict CSP works.`,
		href: href('/guide/server-client/'),
	},
	{
		glyph: '~>',
		title: 'Streams and live state',
		text: 'Return a stream and rows arrive in batched frames. live() keeps rows by key and sends a snapshot, then only what changed, over HTTP or one WebSocket.',
		href: href('/guide/live/'),
	},
	{
		glyph: '≥18',
		title: 'Validation in the types',
		text: 'u8 & Min<18>, string & Email: rules sit next to the types. The server checks every input, and inputSchema() checks forms on the client.',
		href: href('/guide/validation/'),
	},
	{
		glyph: '+',
		title: 'Fits the rest of your stack',
		text: 'TanStack Query options, a Vite plugin, middleware, request batching, cached GET queries and a DevTools panel for Chrome and Firefox.',
		href: href('/guide/tanstack-query/'),
	},
];

const useIt = [
	'A TypeScript client and a TypeScript server that ship together.',
	'Lists of many objects, numeric series, dashboards, realtime frames.',
	'Screens that read a few fields out of large responses.',
	'You want tRPC-style types end to end without a JSON payload.',
];
const skipIt = [
	{ b: 'Public APIs and other languages.', t: 'Use JSON, OpenAPI or protobuf; this is for one TypeScript app talking to its own backend.' },
	{ b: 'Small, text-heavy responses.', t: '20 users come out 10–13% larger than JSON after compression; long product descriptions come out 0–9% smaller.' },
	{ b: 'Debugging with curl | jq.', t: 'Bodies are binary. The DevTools panel, debug: true and tbr decode decode them, but curl shows bytes.' },
	{ b: 'You need the tRPC ecosystem.', t: 'tRPC links, adapters and plugins do not work here; ts-bin-rpc has its own client and integrations.' },
	{ b: 'You need a release proven in production.', t: 'The beta fixes the wire format and the API, but few apps run it yet.' },
];
---

<StarlightPage
	frontmatter={{
		title: 'ts-bin-rpc: code-first TypeScript RPC over a binary wire format',
		description:
			'Write a router of async functions with plain TypeScript types. tbr generate emits codecs; the client reads lazy, zero-copy views over the response bytes.',
		template: 'splash',
		pagefind: false,
		editUrl: false,
		hero: { title: 'ts-bin-rpc' },
	}}
	hasSidebar={false}
>
	<div class="tbr-landing not-content">
		<Flow />

		<section class="features" aria-labelledby="features-title">
			<header class="section-head">
				<p class="kicker">Why</p>
				<h2 id="features-title">tRPC’s ergonomics, without paying for JSON.</h2>
				<p class="sub">The developer experience stays code-first. What changes is what goes over the wire and how the client reads it.</p>
			</header>
			<ul class="feature-grid">
				{
					features.map((f) => (
						<li>
							<a href={f.href}>
								<span class="glyph" aria-hidden="true">{f.glyph}</span>
								<h3>{f.title}</h3>
								<p>{f.text}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<Bench />

		<Libs />

		<section class="fit" aria-labelledby="fit-title">
			<header class="section-head">
				<p class="kicker">Honest fit</p>
				<h2 id="fit-title">When not to use it.</h2>
				<p class="sub">The format is built for many objects, numbers and partial reads. It does not try to beat JSON everywhere.</p>
			</header>
			<div class="fit-grid">
				<div class="fit-card yes">
					<h3><span class="mark" aria-hidden="true">+</span>A good fit</h3>
					<ul>{useIt.map((t) => <li>{t}</li>)}</ul>
				</div>
				<div class="fit-card no">
					<h3><span class="mark" aria-hidden="true">−</span>Stay with JSON when</h3>
					<ul>{skipIt.map((x) => <li><strong>{x.b}</strong> {x.t}</li>)}</ul>
				</div>
			</div>
		</section>

		<section class="cta" aria-labelledby="cta-title">
			<h2 id="cta-title">From a router to a typed binary client in five steps.</h2>
			<div class="cta-actions">
				<a class="btn primary" href={href("/guide/getting-started/")}>Get started</a>
				<a class="btn ghost" href={`${GITHUB}/tree/main/examples/dashboard`}>See the dashboard example</a>
			</div>
		</section>

		<footer class="site-foot">
			<span>ts-bin-rpc · MIT</span>
			<nav aria-label="Footer">
				<a href={href("/guide/")}>Docs</a>
				<a href={href("/guide/performance/")}>Performance</a>
				<a href={href("/guide/faq/")}>FAQ</a>
				<a href={GITHUB}>GitHub</a>
			</nav>
		</footer>
	</div>
</StarlightPage>
